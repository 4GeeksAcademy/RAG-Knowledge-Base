# Copy this file to .env and fill in your own values. Never commit .env.

# OpenAI (used for both generation and embeddings)
LLM_API_KEY=your-openai-api-key
LLM_API_URL=https://api.openai.com/v1

# Generation model: writes the final answer in generate_answer()
LLM_MODEL=gpt-4o-mini

# Embedding model: used by embed(). Must be different from LLM_MODEL
EMBEDDING_MODEL=text-embedding-3-small

# Qdrant (local Docker)
QDRANT_URL=http://localhost:6333
